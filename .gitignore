# --- FinanceBench PDF corpus (158MB public dataset; fetched separately, mounted at runtime) ---
deploy/fb_pdfs/*
!deploy/fb_pdfs/README.md

# --- frontend build ---
web/node_modules/
web/dist/

# --- deploy artifacts (bundles / logs / fetched reports / UI-review screenshots) ---
deploy/*.tar.gz
deploy/*.log
deploy/report-remote.md
deploy/ui-review*/

