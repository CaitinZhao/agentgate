# Sample agent under test (jiuwen fixture): openJiuwen ReAct + bank/fb/locomo/longmem/tau
# tool environments. Build context = the agentgate/ repo root (self-contained):
#   docker build -f Dockerfile.agent -t jiuwen-agent:0.1 .
# The FinanceBench PDF corpus (deploy/fb_pdfs/, fetched separately — see
# deploy/fb_pdfs/README.md) is MOUNTED at runtime, never baked in.
# LLM credentials: create tests/fixtures/.env (LLM_BASE_URL/LLM_API_KEY/LLM_MODEL_NAME)
# and pass --env-file, or set environment: in docker-compose.yml.
FROM python:3.11-slim
WORKDIR /app
COPY tests/fixtures/fin_runtime /app/fin_runtime
COPY tests/fixtures/data /app/data
COPY tests/fixtures/jiuwen_server.py /app/jiuwen_server.py
COPY tests/fixtures/profile_prompts.py /app/profile_prompts.py
COPY tests/fixtures/jiuwen_agent.py /app/tests/fixtures/jiuwen_agent.py
COPY tests/fixtures/tau_envs /app/tau_envs
RUN pip install --no-cache-dir -i https://pypi.tuna.tsinghua.edu.cn/simple       pypdf openjiuwen==0.1.18 fastapi uvicorn httpx "pydantic>=2.0"       opentelemetry-sdk opentelemetry-exporter-otlp opentelemetry-proto       agentdojo==0.1.35
ENV FB_DATA_DIR=/app/fb_data
ENV FB_PDF_DIR=/app/fb_data
ENV JIUWEN_FIXTURE=/app/tests/fixtures/jiuwen_agent.py
ENV OTEL_EXPORTER_OTLP_ENDPOINT=http://agentgate:4318
# public-benchmark assets (generated by `python -m agentgate.case.build_banks --spider --airbench`
# BEFORE the image build; spider DBs are read-only, the AIR-Bench corpus subset feeds in-process BM25)
COPY cases/spider/dbs /app/cases/spider/dbs
COPY cases/airbench/corpus.jsonl /app/cases/airbench/corpus.jsonl
EXPOSE 8200
CMD ["python", "-m", "uvicorn", "jiuwen_server:app", "--host", "0.0.0.0", "--port", "8200"]
