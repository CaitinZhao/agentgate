  },
  "input": {
   "query": "平台为你托管了一个终端沙箱（用法见上下文）。请读取 /app/in/task.txt，然后在 /app/out/ 目录下创建 report.json，内容为 JSON：{\"status\": \"done\", \"task\": \"monthly\"}，并把 /app/in/task.txt 原样复制为 /app/out/task.bak。"
  },
  "type": "state",
  "gold": {
   "final": {
    "sandbox": {
     "image": "python:3.11-slim",
     "setup": [
      {"cmd": "mkdir -p /app/in /app/out"},
      {"write_file": {"path": "/app/in/task.txt", "content": "monthly report data v1"}}
     ]
    },
    "assertions": [
     {"read_file": "/app/out/report.json", "json_path": "status", "equals": "done"},
     {"read_file": "/app/out/report.json", "json_path": "task", "equals": "monthly"},
     {"exec": "test -f /app/out/task.bak", "exit_code": 0},
     {"exec": "diff -q /app/in/task.txt /app/out/task.bak", "exit_code": 0}
    ]
   },
   "checkpoints": [],
   "rubric": []
  },
  "diagnosis_hint": {
   "failure_kind": "environment_state_miss",
   "target_layer": "environment",
   "expected_behavior": "在托管沙箱内完成文件读写，终态满足四条断言"
  }
 },
